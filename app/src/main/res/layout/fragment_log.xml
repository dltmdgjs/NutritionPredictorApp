<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA"
    android:clipToPadding="false"
    android:clipChildren="false"
    tools:context=".ui.log.LogFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- 상단 타이틀 -->
        <TextView
            android:id="@+id/tv_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:text="하루 섭취 분석"
            android:textColor="#1A1A1A"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <!-- 메인 카드: 오늘의 섭취 요약 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_today_intake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오늘 총 섭취 칼로리"
                    android:textColor="#666666"
                    android:textSize="14sp" />

                <!-- 칼로리 강조 (데이터 연결 시 활용) -->
                <TextView
                    android:id="@+id/tv_today_calories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 kcal"
                    android:textColor="#2E7D32"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginVertical="20dp" />

                <TextView
                    android:id="@+id/tv_load_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:text="섭취 기록이 없습니다.\n사진을 찍어 식단을 기록해 보세요!"
                    android:textColor="#999999"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_today_food"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="오늘 먹은 음식 확인하기"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 하단 섹션: 영양 성분 그래프 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="영양 성분 밸런스"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                android:layout_gravity="start"/>

            <!-- 가짜 그래프 영역 (MPAndroidChart 적용 전 미리보기용) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 탄수화물 바 -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="탄수화물" android:textSize="12sp" />
                    <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progress="60" android:progressTint="#FFA726" android:layout_marginBottom="12dp"/>

                    <!-- 단백질 바 -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="단백질" android:textSize="12sp" />
                    <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progress="40" android:progressTint="#66BB6A" android:layout_marginBottom="12dp"/>

                    <!-- 지방 바 -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="지방" android:textSize="12sp"/>
                    <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progress="30" android:progressTint="#EF5350"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- 스크롤 하단 여유 공간 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="100dp" />

    </LinearLayout>
</ScrollView>