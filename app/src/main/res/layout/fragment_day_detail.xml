<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootDayDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:padding="30dp"
    android:layout_marginBottom="50dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="2025-12-30"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvAmdrNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="AMDR: 탄수 55~65%, 단백질 7~20%, 지방 15~30%"
            android:textSize="12sp"
            android:textColor="#616161"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/tvDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="총합: 0kcal, P 0g, C 0g, F 0g"
            android:textSize="13sp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tvAmdrNote"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- 차트 영역 (2열 그리드 느낌) -->
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieCalories"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvSummary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/pieProtein"/>

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieProtein"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvSummary"
            app:layout_constraintStart_toEndOf="@id/pieCalories"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieCarbs"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/pieCalories"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/pieFats"/>

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieFats"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/pieProtein"
            app:layout_constraintStart_toEndOf="@id/pieCarbs"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieFiber"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/pieCarbs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/pieSugars"/>

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieSugars"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/pieFats"
            app:layout_constraintStart_toEndOf="@id/pieFiber"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieSodium"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/pieFiber"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- (선택) 해당 날짜 로그 리스트 -->
        <TextView
            android:id="@+id/tvLogsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="섭취 내역"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/pieSodium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvFoods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="음식명"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tvLogsTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

<!--        <androidx.recyclerview.widget.RecyclerView-->
<!--            android:id="@+id/rvLogs"-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="320dp"-->
<!--            android:overScrollMode="never"-->
<!--            android:layout_marginTop="8dp"-->
<!--            app:layout_constraintTop_toBottomOf="@id/tvLogsTitle"-->
<!--            app:layout_constraintStart_toStartOf="parent"-->
<!--            app:layout_constraintEnd_toEndOf="parent"-->
<!--            app:layout_constraintBottom_toBottomOf="parent"/>-->

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
