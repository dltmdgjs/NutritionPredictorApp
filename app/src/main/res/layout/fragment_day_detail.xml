<?xml version="1.0" encoding="utf-8"?><androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootDayDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- 1. 헤더 카드: 날짜 및 요약 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2025-12-30"
                    android:textColor="#1A1A1A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="총합: 0kcal | P 0g | C 0g | F 0g"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvAmdrNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="권장 섭취 비율(AMDR) 기준 분석"
                    android:textColor="#999999"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. 영양 분석 리포트 제목 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="영양 분석 리포트"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="4dp"/>

        <!-- 3. 차트 그리드 영역 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="20dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="10dp">

                <!-- 칼로리 & 단백질 -->
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieCalories"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_columnWeight="1" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieProtein"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_columnWeight="1" />

                <!-- 탄수화물 & 지방 -->
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieCarbs"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_columnWeight="1" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieFats"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_columnWeight="1" />

                <!-- 식이섬유 & 당류 -->
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieFiber"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_columnWeight="1" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieSugars"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_columnWeight="1" />
            </GridLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. 나트륨 단독 카드 (중요도가 높으므로 크게 배치) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="20dp">

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pieSodium"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:padding="12dp" />
        </androidx.cardview.widget.CardView>

        <!-- 5. 섭취 내역 리스트 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvLogsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="상세 섭취 내역"
                    android:textColor="#1A1A1A"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvFoods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="음식 정보 로딩 중..."
                    android:lineSpacingExtra="6dp"
                    android:textSize="15sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 스크롤 하단 여유 공간 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="120dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
