<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.seunghun.nutritionpredictorapp.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_user"
        android:name="com.seunghun.nutritionpredictorapp.ui.user.UserFragment"
        android:label="@string/title_user"
        tools:layout="@layout/fragment_user" />

    <fragment
        android:id="@+id/navigation_log"
        android:name="com.seunghun.nutritionpredictorapp.ui.log.LogFragment"
        android:label="@string/title_log"
        tools:layout="@layout/fragment_log" />

    <fragment
        android:id="@+id/navigation_calendar"
        android:name="com.seunghun.nutritionpredictorapp.ui.calendar.CalendarFragment"
        android:label="@string/title_calendar"
        tools:layout="@layout/fragment_calendar">
        <action
            android:id="@+id/action_calendar_to_dayDetail"
            app:destination="@id/dayDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/dayDetailFragment"
        android:name="com.seunghun.nutritionpredictorapp.ui.day.DayDetailFragment"
        android:label="Day Detail" >
        <argument
            android:name="date"
            app:argType="string"
            app:nullable="false" />
    </fragment>
</navigation>